<Project Sdk="Microsoft.NET.Sdk">
  <!-- Project Configuration & Target Framework -->
  <PropertyGroup>
    <!-- .NET 8.0 is required for Stardew Valley 1.6+ and SMAPI 4.0+ -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NoBackKey</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    
    <!-- Path to the game folder containing SMAPI and Stardew Valley binaries -->
    <GameDir>/storage/emulated/0/Download/StardewValley</GameDir>
  </PropertyGroup>

  <!-- Assembly References (Provided by the game/SMAPI at runtime) -->
  <ItemGroup>
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GameDir)/StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GameDir)/Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces">
      <HintPath>$(GameDir)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GameDir)/MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(GameDir)/xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Output Assets Deployment: Copy manifest and localized translations to build output -->
  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="i18n\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
